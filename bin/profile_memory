#!/usr/bin/env ruby
# frozen_string_literal: true

# Memory profiling script for Ruby LSP's indexer
# Usage: bundle exec ruby bin/profile_memory

require "objspace"
require_relative "../lib/ruby_lsp/internal"

ObjectSpace.trace_object_allocations_start

puts "Initializing index..."
t_start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
index = RubyIndexer::Index.new
freshly_indexed = index.index_all
t_end = Process.clock_gettime(Process::CLOCK_MONOTONIC)

puts "Index complete. Analyzing memory..."
puts

GC.start
GC.start
GC.start

indexing_time = (t_end - t_start).round(2)
puts "=== Indexing ==="
puts "  Time:    #{indexing_time}s"
puts "  Mode:    #{freshly_indexed ? "FRESH (built SQLite DB)" : "CACHED (reused existing SQLite DB)"}"
puts

# Count and measure entries by type (only in-memory entries remain after SQLite offload)
entry_counts = Hash.new(0)
entry_sizes = Hash.new(0)
total_entries = 0

ObjectSpace.each_object(RubyIndexer::Entry) do |entry|
  type = entry.class.name&.sub("RubyIndexer::Entry::", "") || "Entry"
  entry_counts[type] += 1
  entry_sizes[type] += ObjectSpace.memsize_of(entry)
  total_entries += 1
end

puts "=== In-Memory Entry Objects (workspace only) ==="
puts format("%-35s %8s %12s", "Type", "Count", "Size (KB)")
puts "-" * 57
entry_counts.sort_by { |_, count| -count }.each do |type, count|
  puts format("%-35s %8d %12.1f", type, count, entry_sizes[type] / 1024.0)
end
puts "-" * 57
puts format("%-35s %8d %12.1f", "TOTAL", total_entries, entry_sizes.values.sum / 1024.0)
puts

# SQLite store stats
sqlite_store = index.instance_variable_get(:@sqlite_store)
if sqlite_store
  db = sqlite_store.db
  sqlite_entry_count = db.get_first_value("SELECT COUNT(*) FROM entries")
  sqlite_name_count = db.get_first_value("SELECT COUNT(DISTINCT name) FROM entries")
  sqlite_uri_count = db.get_first_value("SELECT COUNT(DISTINCT uri) FROM entries")
  sqlite_sig_count = db.get_first_value("SELECT COUNT(*) FROM signatures")
  sqlite_param_count = db.get_first_value("SELECT COUNT(*) FROM parameters")
  sqlite_mixin_count = db.get_first_value("SELECT COUNT(*) FROM mixin_operations")
  sqlite_require_count = db.get_first_value("SELECT COUNT(*) FROM require_paths")

  # DB file size on disk
  db_path = db.filename
  db_file_size = File.exist?(db_path) ? File.size(db_path) / (1024.0 * 1024) : 0

  puts "=== SQLite Store (gems + stdlib) ==="
  puts "  Entries:          #{sqlite_entry_count} (#{sqlite_name_count} unique names)"
  puts "  Files (URIs):     #{sqlite_uri_count}"
  puts "  Signatures:       #{sqlite_sig_count}"
  puts "  Parameters:       #{sqlite_param_count}"
  puts "  Mixin operations: #{sqlite_mixin_count}"
  puts "  Require paths:    #{sqlite_require_count}"
  puts "  DB file size:     #{db_file_size.round(1)} MB"
  puts "  DB path:          #{db_path}"
  puts
end

# PrefixTree nodes (only workspace entries remain)
node_count = 0
node_size = 0
ObjectSpace.each_object(RubyIndexer::PrefixTree::Node) do |node|
  node_count += 1
  node_size += ObjectSpace.memsize_of(node)
end
puts "=== PrefixTree (workspace only) ==="
puts "  Node count: #{node_count}"
puts "  Node size:  #{(node_size / 1024.0).round(1)} KB"
puts

# URI objects
uri_count = 0
uri_size = 0
ObjectSpace.each_object(URI::Generic) do |uri|
  uri_count += 1
  uri_size += ObjectSpace.memsize_of(uri)
end
puts "=== URI::Generic Objects ==="
puts "  Total URI objects: #{uri_count}"
puts "  Total URI size:    #{(uri_size / 1024.0).round(1)} KB"
puts

# Location objects (only workspace entries remain)
location_count = 0
location_size = 0
ObjectSpace.each_object(RubyIndexer::Location) do |loc|
  location_count += 1
  location_size += ObjectSpace.memsize_of(loc)
end
puts "=== Location Objects (workspace only) ==="
puts "  Count: #{location_count}"
puts "  Size:  #{(location_size / 1024.0).round(1)} KB"
puts

# Hash overhead
entries_hash = index.instance_variable_get(:@entries)
uris_hash = index.instance_variable_get(:@uris_to_entries)
ancestors_hash = index.instance_variable_get(:@ancestors)

puts "=== In-Memory Hash Data Structures ==="
puts "  @entries:          #{entries_hash.size} keys, #{(ObjectSpace.memsize_of(entries_hash) / 1024.0).round(1)} KB"
puts "  @uris_to_entries:  #{uris_hash.size} keys, #{(ObjectSpace.memsize_of(uris_hash) / 1024.0).round(1)} KB"
puts "  @ancestors:        #{ancestors_hash.size} keys, #{(ObjectSpace.memsize_of(ancestors_hash) / 1024.0).round(1)} KB"
puts

# Overall memory
puts "=== Overall Process Memory ==="
rss_kb = `ps -o rss= -p #{Process.pid}`.strip.to_i
puts "  RSS:             #{(rss_kb / 1024.0).round(1)} MB"
puts "  ObjectSpace:     #{(ObjectSpace.memsize_of_all / (1024.0 * 1024)).round(1)} MB"
