#!/usr/bin/env ruby
# frozen_string_literal: true

# Memory profiling script for Ruby LSP's indexer
# Usage: bundle exec ruby bin/profile_memory

require "objspace"
require_relative "../lib/ruby_lsp/internal"

ObjectSpace.trace_object_allocations_start

puts "Initializing index..."
index = RubyIndexer::Index.new
index.index_all

puts "Index complete. Analyzing memory..."
puts

GC.start
GC.start
GC.start

# Count and measure entries by type
entry_counts = Hash.new(0)
entry_sizes = Hash.new(0)
total_entries = 0

ObjectSpace.each_object(RubyIndexer::Entry) do |entry|
  type = entry.class.name&.sub("RubyIndexer::Entry::", "") || "Entry"
  entry_counts[type] += 1
  entry_sizes[type] += ObjectSpace.memsize_of(entry)
  total_entries += 1
end

puts "=== Entry Objects ==="
puts format("%-35s %8s %12s", "Type", "Count", "Size (KB)")
puts "-" * 57
entry_counts.sort_by { |_, count| -count }.each do |type, count|
  puts format("%-35s %8d %12.1f", type, count, entry_sizes[type] / 1024.0)
end
puts "-" * 57
puts format("%-35s %8d %12.1f", "TOTAL", total_entries, entry_sizes.values.sum / 1024.0)
puts

# PrefixTree nodes
node_count = 0
node_size = 0
ObjectSpace.each_object(RubyIndexer::PrefixTree::Node) do |node|
  node_count += 1
  node_size += ObjectSpace.memsize_of(node)
end
puts "=== PrefixTree ==="
puts "  Node count: #{node_count}"
puts "  Node size:  #{(node_size / 1024.0).round(1)} KB"
puts

# URI objects
uri_count = 0
uri_size = 0
uri_strings = Set.new
ObjectSpace.each_object(URI::Generic) do |uri|
  uri_count += 1
  uri_size += ObjectSpace.memsize_of(uri)
  uri_strings << uri.to_s
end
puts "=== URI::Generic Objects ==="
puts "  Total URI objects:  #{uri_count}"
puts "  Unique URI strings: #{uri_strings.size}"
puts "  Duplication ratio:  #{uri_count > 0 ? (uri_count.to_f / uri_strings.size).round(1) : 0}x"
puts "  Total URI size:     #{(uri_size / 1024.0).round(1)} KB"
puts

# Location objects
location_count = 0
location_size = 0
ObjectSpace.each_object(RubyIndexer::Location) do |loc|
  location_count += 1
  location_size += ObjectSpace.memsize_of(loc)
end
puts "=== Location Objects ==="
puts "  Count: #{location_count}"
puts "  Size:  #{(location_size / 1024.0).round(1)} KB"
puts

# String duplication analysis
entry_names = []
owner_names = []
uri_to_s_values = []

ObjectSpace.each_object(RubyIndexer::Entry) do |entry|
  entry_names << entry.name
  if entry.respond_to?(:owner) && entry.owner
    owner_names << entry.owner.name
  end
  uri_to_s_values << entry.uri.to_s
end

puts "=== String Duplication ==="
puts "  Entry @name strings:"
puts "    Total:  #{entry_names.size}"
puts "    Unique: #{entry_names.uniq.size}"
puts "    Frozen: #{entry_names.count(&:frozen?)}"
puts "  Owner names referenced:"
puts "    Total:  #{owner_names.size}"
puts "    Unique: #{owner_names.uniq.size}"
puts "  URI .to_s values:"
puts "    Total:  #{uri_to_s_values.size}"
puts "    Unique: #{uri_to_s_values.uniq.size}"
puts

# Hash overhead
entries_hash = index.instance_variable_get(:@entries)
uris_hash = index.instance_variable_get(:@uris_to_entries)
ancestors_hash = index.instance_variable_get(:@ancestors)

puts "=== Hash Data Structures ==="
puts "  @entries:          #{entries_hash.size} keys, #{(ObjectSpace.memsize_of(entries_hash) / 1024.0).round(1)} KB"
puts "  @uris_to_entries:  #{uris_hash.size} keys, #{(ObjectSpace.memsize_of(uris_hash) / 1024.0).round(1)} KB"
puts "  @ancestors:        #{ancestors_hash.size} keys, #{(ObjectSpace.memsize_of(ancestors_hash) / 1024.0).round(1)} KB"
puts

# Configuration references
puts "=== Configuration ==="
puts "  Configuration is now a class-level accessor (no per-entry overhead)"
puts

# Overall memory
puts "=== Overall Process Memory ==="
rss_kb = `ps -o rss= -p #{Process.pid}`.strip.to_i
puts "  RSS: #{(rss_kb / 1024.0).round(1)} MB"
puts "  ObjectSpace total: #{(ObjectSpace.memsize_of_all / (1024.0 * 1024)).round(1)} MB"
